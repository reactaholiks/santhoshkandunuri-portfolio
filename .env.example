# ============================================================================
#  Copy this file to ".env.local" and fill in real values.
#  Next.js loads .env.local automatically — no dotenv package needed.
#  Vars WITHOUT the NEXT_PUBLIC_ prefix are server-only (never sent to the
#  browser), which is exactly what we want for SMTP secrets.
# ============================================================================

# --- Sanity CMS — create a free project at https://www.sanity.io/manage ---
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production

# Where contact-form emails are delivered (defaults to SMTP_USER if unset).
CONTACT_TO=santhoshkandunuri0620@gmail.com

# ---------------------------------------------------------------------------
#  SMTP — FREE option: Gmail with an "App Password"
#  1. Enable 2-Step Verification on your Google account.
#  2. Visit  https://myaccount.google.com/apppasswords
#  3. Create an app password, paste the 16-char code (no spaces) into SMTP_PASS.
# ---------------------------------------------------------------------------
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=santhoshkandunuri0620@gmail.com
SMTP_PASS=your-16-char-app-password
